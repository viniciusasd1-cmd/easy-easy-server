NODE_ENV=development
PORT=4000
BASE_URL=http://localhost:4000

# Supabase: use a chave secreta moderna (sb_secret_...) ou a service_role legada.
# Nunca coloque essa chave na extensão ou em código público.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_SUBSTITUA_AQUI

# mercado_pago para cobranças reais; mock para desenvolvimento local.
PAYMENT_PROVIDER=mock
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# Opcional: usada apenas se um frontend Mercado Pago for adicionado no futuro.
# O backend PIX atual usa somente o Access Token.
MERCADO_PAGO_PUBLIC_KEY=

# IDs separados por vírgula, encontrados em chrome://extensions.
ALLOWED_EXTENSION_IDS=
ALLOW_ANY_EXTENSION_ORIGIN=true

# Somente desenvolvimento local com PAYMENT_PROVIDER=mock.
ALLOW_MOCK_PAYMENT_APPROVAL=true
